# Copy to .env and fill in whichever providers you have keys for.
# Any provider left blank automatically falls back to deterministic demo scoring
# for that judge, so the app runs fully functional with zero keys configured.

# --- OpenAI (for gpt-4o / gpt-4o-mini judges) ---
OPENAI_API_KEY=

# --- OR Azure OpenAI (used instead of OpenAI if endpoint+key are set) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
GPT4O_DEPLOYMENT=gpt-4o
GPT4O_MINI_DEPLOYMENT=gpt-4o-mini

# --- Anthropic (for the claude judge) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest

# --- Consensus behaviour ---
REVIEW_THRESHOLD=3
FORCE_DEMO_MODE=false
